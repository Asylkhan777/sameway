# Vision model for reading worksheet photos (Google AI Studio, free tier)
GOOGLE_GENERATIVE_AI_API_KEY=
# Model ids: two different free-tier Gemini Flash models (quota and load are per model).
# Copy current ids from Google AI Studio, e.g. gemini-3.5-flash and gemini-3.5-flash-lite.
VISION_MODEL=
VISION_MODEL_FALLBACK=
# Stripe test mode (sk_test_...)
STRIPE_SECRET_KEY=
# Public URL of the deployment (http://localhost:3000 locally)
NEXT_PUBLIC_SITE_URL=
